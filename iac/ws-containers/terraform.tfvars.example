# Copy to terraform.tfvars and fill in.
# subscription_id = "00000000-0000-0000-0000-000000000000"
# location        = "westeurope" # pick a region where your VM sizes and spot capacity are available

# name_prefix = "ss"

# Optional
# kubernetes_version   = "1.33"
# system_vm_size       = "Standard_D2as_v5"
# spot_vm_size         = "Standard_D2as_v5"
# spot_min_count       = 0
# spot_max_count       = 2
# authorized_ip_ranges = ["203.0.113.4/32"] # your public IP, to lock down the API server
